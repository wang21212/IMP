#!/bin/sh
# IMP pre-commit hook — auto-rebuild windsurf/ and dsh/ from core/
# Cross-platform: works on Windows (Git Bash) and macOS/Linux

echo "[IMP] pre-commit: auto-rebuilding platform skills..."

SCRIPT="scripts/build.ps1"
if [ ! -f "$SCRIPT" ]; then
  echo "[IMP] pre-commit: build.ps1 not found, skipping"
  exit 0
fi

# Try pwsh first (macOS/Linux + Windows PowerShell Core), then powershell.exe (Windows)
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
else
  echo "[IMP] pre-commit: PowerShell not found, skipping rebuild"
  exit 0
fi

# Stage generated outputs
git add windsurf/ dsh/

echo "[IMP] pre-commit: rebuild complete, staged windsurf/ and dsh/"
